[Unit]
Requires=onekvm-plugin-update.service
After=onekvm-plugin-update.service
Description=OneKVM extension lifecycle host
BindsTo=onekvm.service
After=dbus.socket onekvm.service
Requires=dbus.socket

[Service]
Type=notify
NotifyAccess=main
# The host claims its D-Bus name immediately, then reports READY after the first
# ReconcileAll attempt (including partial per-extension failures) so a single
# extension start error cannot hold Type=notify until TimeoutStartSec.
ExecStart=/usr/bin/onekvm-extension-host
Restart=on-failure
RestartSec=1s
Slice=system-onekvm.slice
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
# The host builds per-extension DeviceAllow lists from the real /dev tree.
# DevicePolicy keeps the host itself from opening those devices.
PrivateDevices=no
DevicePolicy=closed
ProtectSystem=strict
ProtectHome=yes
# The host modprobes kernel_modules named in extension manifests.
# Each extension unit still sets ProtectKernelModules=yes.
ProtectKernelModules=no
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/etc/onekvm /etc/opkg /data /run/onekvm /run/systemd/system
# The privileged package manager installs signed runtime dependencies in /usr,
# including client executables and libraries. Individual extension services
# retain their own read-only system mounts.
ReadWritePaths=/usr
